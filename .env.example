# Generate independent secrets for persistent API deployments.
# python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=replace-with-a-strong-random-key
# Optional; required to read GET /api/audit/logs (X-Audit-Token header).
AUDIT_READ_TOKEN=replace-with-a-different-strong-random-token
MODEL_PROVIDER=mock
HOST=127.0.0.1
PORT=8000
